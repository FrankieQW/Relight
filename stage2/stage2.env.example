# Copy this file outside version control (for example datacompose/stage2/stage2.env),
# fill the operator-owned paths/policies, then run datacompose/stage2/run_stage2.sh.

# Executables and base configuration.
PYTHON_BIN=python
BLENDER_BIN=/opt/blender-4.5/blender
PROJECT_BASE_CONFIG=configs/default.yaml
TOKENLIGHT_BASE_CONFIG=Lumina-T2X/lumina_next_t2i/config.yaml
RUNTIME_DIR=outputs/stage2_runtime

# Objaverse assets are resolved from object-paths.json relative to this root.
OBJECT_ROOT=/absolute/path/to/Objaverse
HDRI_ROOT=/absolute/path/to/polyhaven_hdri

# These are inputs produced outside this script. Stage 1 is deliberately not
# generated or trained here.
STAGE1_CHECKPOINT=/absolute/path/to/stage1/checkpoints/step_XXXXXXXXX
VAE_PATH=/absolute/path/to/sdxl-vae

# Composition data and TokenLight outputs.
DATASET_ROOT=outputs/tokenlight_dataset
TOKENLIGHT_OUTPUT_ROOT=outputs/tokenlight_training

# Formal composition renders must use a verified policy. Use comma-separated
# canonical license names matching object.json.
OBJECT_LICENSE_ALLOWLIST=cc-by-4.0,cc0-1.0
LICENSE_POLICY_VERSION=operator-policy-v1
BASE_SCENE_LICENSE_NAME=CC-BY-4.0
BASE_SCENE_SOURCE_URI=https://developer.nvidia.com/orca/amazon-lumberyard-bistro
BASE_SCENE_ATTRIBUTION="NVIDIA Amazon Lumberyard Bistro scene"
BASE_SCENE_LICENSE_DECISION=allowed

# Annotation. REUSE_ANNOTATION=true freezes and reuses the existing M1-M3
# object.json, scene.json, normalized blends, and annotation_construction.json;
# their digests are checked before M4. Set it to false to rebuild M1-M3. An
# OpenAI-compatible vLLM endpoint is needed only for that rebuild, and
# START_VLLM=true lets this script own the server.
REUSE_ANNOTATION=true
START_VLLM=false
VLLM_BIN=vllm
VLLM_MODEL=Qwen/Qwen3-14B
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_GPU_IDS=0
VLLM_CONCURRENCY=16
VLLM_WAIT_SECONDS=600

# Blender composition rendering. Each worker keeps one Blender process alive
# for its assigned jobs. One worker per GPU is the conservative default.
RENDER_GPU_IDS=0,1,2,3,4,5,6,7
RENDER_WORKERS=8
RENDER_RESOLUTION=960
RENDER_SAMPLES=64
RENDER_PERSISTENT_DATA=true
MAX_RENDER_JOBS=

# Stage-2 fixed-manifest smoke. This is intentionally single-GPU.
SMOKE_GPU_ID=0
SMOKE_MAX_MANIFEST_ROWS=16
SMOKE_MAX_SCHEDULE_SAMPLES=64
SMOKE_RUN_ID=tokenlight_stage2_fixed_smoke_v1

# Stage-2 formal 8-GPU DDP training. Effective global batch is
# micro_batch_size * gradient_accumulation_steps * number_of_GPUs.
TRAIN_GPU_IDS=0,1,2,3,4,5,6,7
FORMAL_RUN_ID=tokenlight_stage2_composition_v1
FORMAL_MICRO_BATCH_SIZE=1
FORMAL_GRADIENT_ACCUMULATION_STEPS=4
FORMAL_MAX_STEPS=15000
FORMAL_LEARNING_RATE=0.000002
FORMAL_NUM_WORKERS=4
FORMAL_ACTIVATION_CHECKPOINTING=true
FORMAL_RESUME_CHECKPOINT=

# Evaluation uses one GPU. Leave EVAL_CHECKPOINT empty to select the newest
# checkpoint in the formal run after training.
EVAL_GPU_ID=0
EVAL_CHECKPOINT=
